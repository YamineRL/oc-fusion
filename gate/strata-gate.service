# Copy to ~/.config/systemd/user/, set the paths, then:
#   systemctl --user daemon-reload && systemctl --user enable --now strata-gate
[Unit]
Description=strata-gate: one queue in front of the local model server
After=network.target

[Service]
ExecStart=/usr/bin/env node %h/oc-fusion/gate/gate.mjs
# GATE_PORT (8082) is where clients connect; GATE_UPSTREAM_PORT (8091) is
# llama-swap or a single model server.
Environment=GATE_PORT=8082
Environment=GATE_UPSTREAM_PORT=8091
Environment=OWNER_GRACE_S=180
# Optional: a folder whose *.md file names are seat agent names.
#Environment=GATE_SEATS_DIR=%h/seats
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
