{
  "$schema": "https://opencode.ai/config.json",

  // The lead agent. The fusion plugin rewrites model/variant from fusion.jsonc
  // at load, so this is only the fallback if the plugin is disabled.
  "default_agent": "fusion",
  "model": "merge-gateway/zai/glm-5.3",

  // Titles and other throwaway calls. Deliberately NOT the local model: every
  // new session would then wake the GPU to name a chat. glm-5.3-flash is
  // $0.015/$0.05 per M, so this is fractions of a cent a day, and it keeps the
  // shared card free for work you actually asked for.
  "small_model": "merge-gateway/zai/glm-5.3-flash",

  // `oc` runs opencode in your project, so the project's own .opencode/
  // auto-discovery never finds the harness plugins: this list is what loads
  // them. Paths are relative to this file. Entries are directories: v2 drops
  // a file path with "configured plugin path must be a directory", and v1
  // loads the directory's index. Order matters: fusion must see commands
  // before rtk rewrites them. Keep plugin files out of .opencode/plugin/, or
  // opencode in this repo loads them twice ("Duplicate plugin ID").
  "plugin": ["./plugins/fusion", "./plugins/rtk"],

  // Fusion's efficiency comes from fewer, fatter round trips.
  //   batch_tool / primary_tools: v1-only. v2 batches through the built-in
  //   codemode "execute" tool instead, and the primary_tools effect lives in
  //   the per-agent permissions below (only the lead may spawn subagents or
  //   call escalate/work_order). The keys stay because the Mac host is v1;
  //   the plugin audits them so they are documented, not silently dead.
  //   subagent_depth lives under experimental so BOTH hosts read it: v2
  //   drops the top-level key but honors this one. Subagents must not spawn
  //   subagents: on --parallel 1 that deadlocks the single local slot.
  "experimental": {
    "batch_tool": true,
    "primary_tools": ["task", "escalate", "work_order"],
    "subagent_depth": 1
  },

  "compaction": {
    "auto": true,
    // v1 flag; v2 drops it, so the fusion plugin prunes stale tool outputs
    // itself on v2 (see plugins/fusion). Keep it: same file serves v1.
    "prune": true,
    // v1 keeps the last N turns verbatim; v2 counts TOKENS instead and reads
    // preserve_recent_tokens (mapped to keep.tokens). Both keys stay: turns
    // and tokens are not convertible, so this is an honest budget, not a
    // translation. ~8 turns of chat ≈ 16000 tokens.
    "tail_turns": 8,
    "preserve_recent_tokens": 16000,
    "reserved": 8000
  },

  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 40000
  },

  // Local repo context graph: https://github.com/trailhq/Graft
  // `graft mcp` is a stdio server that indexes the graph of the project you have
  // open: opencode starts it with the session's project directory as its cwd, and
  // graft resolves the nearest graft/ index from there — so whatever repo you work
  // in is what gets indexed, and no path is pinned in this file. Needs the global
  // graft CLI (`npm install -g @nanonets/graft`) and a `graft/` index in the
  // project (`graft build`, structural, no LLM, no key). Without an index the
  // server starts and advertises no tools; the agents fall back to grep/scout.
  // Restart opencode after any change to this block.
  "mcp": {
    "graft": {
      "type": "local",
      "command": ["oc-fusion", "graft", "mcp"],
      "enabled": true,
      "environment": {
        // The launcher also blocks network access for child processes using
        // Linux user/network namespaces. DO_NOT_TRACK alone does NOT stop
        // Graft's npm update check. No remote enrichment through this wrapper.
        "DO_NOT_TRACK": "1"
      }
    }
  },

  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "{file:~/.config/llama-server/api-key}"
      },
      "models": {
        // "id" is a placeholder. The fusion plugin overwrites every local
        // alias id at load with the wire id of whatever your llama-server has
        // resident (its --alias, or the .gguf basename) -- so the harness
        // always talks to the model your server is actually running. Pin it
        // instead with "local_model" in fusion.jsonc if you want it fixed.
        // All aliases share one id on purpose: llama-server --models-max 1
        // unloads the resident model if asked for another, and identical ids
        // across profiles make that impossible.
        "fusion-sidekick": {
          "id": "local",
          "name": "Sidekick (medium effort)",
          "tool_call": true,
          "reasoning": true,
          "temperature": false,
          "options": { "chat_template_kwargs": { "reasoning_effort": "medium" } },
          "limit": { "context": 44000, "output": 16384 },
          "cost": { "input": 0, "output": 0 }
        },
        "fusion-sidekick-fast": {
          "id": "local",
          "name": "Sidekick (low effort)",
          "tool_call": true,
          "reasoning": true,
          "temperature": false,
          "options": { "chat_template_kwargs": { "reasoning_effort": "low" } },
          "limit": { "context": 44000, "output": 8192 },
          "cost": { "input": 0, "output": 0 }
        },
        "fusion-sidekick-deep": {
          "id": "local",
          "name": "Sidekick (high effort)",
          "tool_call": true,
          "reasoning": true,
          "temperature": false,
          "options": { "chat_template_kwargs": { "reasoning_effort": "high" } },
          "limit": { "context": 44000, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    },
    // Strata engine (github.com/Niko1221/Strata): the default sidekick.
    // Qwen3.8-Flash-Next on one GPU plus system RAM. Separate port and key
    // from llama-server; Strata's own default port is 8080, so start it with
    // --port 8082 or change baseURL. Strata serves one model and answers
    // every model name with it: "id" is a label, but "limit.context" must
    // not exceed the max_context Strata reports (`oc-fusion doctor` checks).
    "strata": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Strata (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8082/v1",
        "apiKey": "{file:~/.config/strata/api-key}"
      },
      "models": {
        // `oc-fusion sidekick strata`: strata-iq3 is the general-model
        // alias. Run another quant (IQ3_S, IQ2_XS, ...)? Set "id" to the
        // "model" /health reports and "limit.context" to its "max_context".
        // The alias name stays the same.
        "strata-iq3": {
          "id": "qwen3.8-flash-next-iq3_xxs",
          "name": "Strata IQ3_XXS",
          "tool_call": true,
          "reasoning": true,
          "temperature": false,
          "options": { "reasoning_effort": "medium" },
          "limit": { "context": 98304, "output": 16384 },
          "cost": { "input": 0, "output": 0 }
        },
        // `oc-fusion sidekick strata-coder`: Coder IQ1_M. Strata serves one
        // model, so run the Coder instead of the general model first.
        "strata-coder": {
          "id": "qwen3.8-flash-next-coder-iq1_m",
          "name": "Strata Coder (IQ1_M)",
          "tool_call": true,
          "reasoning": true,
          "temperature": false,
          "options": { "reasoning_effort": "medium" },
          "limit": { "context": 32768, "output": 16384 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    }
  },

  "agent": {
    "fusion": {
      "description": "Lead. Frontier model that plans, decides, and delegates bulk work to the sidekick.",
      "mode": "primary",
      "model": "merge-gateway/zai/glm-5.3",
      "variant": "high",
      "prompt": "{file:./prompts/fusion.md}",
      // No "steps" here: under v2 a declared field beats the plugin's agent
      // transform, and the plugin owns the step budget so /fusion speed
      // (fast = 200, normal = 400) can change it without a restart.
      // The v2 runner gives an agent with no ruleset a deny-everything
      // default, so this block is load-bearing, not a nicety. Keep it in this
      // file rather than another config's agent map: a later config source's
      // "agent" object replaces this whole map instead of merging, and the
      // other agents vanish with it.
      "permission": {
        "*": "allow",
        "doom_loop": "deny",
        "external_directory": "ask",
        "question": "allow"
      }
    },
    "scout": {
      "description": "Read-only explorer on the local model. Use for finding files, tracing call sites, summarizing how something works. Returns findings, never patches.",
      "mode": "subagent",
      // No "model" here on purpose, also for grunt and critic: under v2 a
      // model in this table beats the plugin, and the fusion plugin sets
      // these seats from fusion.jsonc ("sidekick", "critic"). Without the
      // plugin they fall back to the top-level "model".
      "prompt": "{file:./prompts/scout.md}",
      "steps": 60,
      "permission": {
        "edit": "deny",
        "write": "deny",
        // Lead-only tools (v1 primary_tools, v2 per-agent permissions):
        // a sidekick seat may not spawn subagents, escalate or file orders.
        "task": "deny",
        "subagent": "deny",
        "escalate": "deny",
        "work_order": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow", "git diff*": "allow", "git show*": "allow",
          "rg *": "allow", "grep *": "allow", "fd *": "allow",
          "ls *": "allow", "cat *": "allow", "sed -n *": "allow",
          "wc *": "allow", "head *": "allow", "tail *": "allow",
          // Graft read-query forms only (via the harness forwarder): locate,
          // trace, orient. Never build/init/uninstall. Queries may refresh the
          // local graft/ cache: a structural local rebuild, not a write to the
          // project's source.
          "oc-fusion graft ask*": "allow",
          "oc-fusion graft grep*": "allow",
          "oc-fusion graft skeleton*": "allow",
          "oc-fusion graft callers*": "allow",
          "oc-fusion graft map*": "allow",
          "oc-fusion graft check*": "allow"
        }
      }
    },
    "grunt": {
      "description": "Mechanical editor on the local model. Use for well-specified changes: renames, applying a described patch, wiring boilerplate, fixing a failing test whose cause is known.",
      "mode": "subagent",
      "prompt": "{file:./prompts/grunt.md}",
      "steps": 80,
      // Same deny-everything default as fusion: no ruleset, no tool calls.
      "permission": {
        "*": "allow",
        "doom_loop": "deny",
        "external_directory": "ask",
        "question": "allow",
        // Lead-only tools: no nested subagents, no escalation, no orders.
        "task": "deny",
        "subagent": "deny",
        "escalate": "deny",
        "work_order": "deny"
      }
    },
    "oracle": {
      "description": "Frontier model at max reasoning. Use ONLY for a genuinely hard, isolated problem: a subtle bug, a design trade-off, an algorithm. Costs real money per call.",
      "mode": "subagent",
      "model": "merge-gateway/anthropic/claude-fable-5-1",
      "variant": "max",
      "prompt": "{file:./prompts/oracle.md}",
      "steps": 40,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task": "deny",
        "subagent": "deny",
        "escalate": "deny",
        "work_order": "deny"
      }
    },
    "critic": {
      "description": "Reviews a diff for correctness before you call the work done.",
      "mode": "subagent",
      "prompt": "{file:./prompts/critic.md}",
      "steps": 40,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task": "deny",
        "subagent": "deny",
        "escalate": "deny",
        "work_order": "deny"
      }
    }
  }
}
