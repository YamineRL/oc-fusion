#!/usr/bin/env bash
# Fusion control panel CLI. Edits fusion.jsonc in place.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Same precedence as the plugin's readProfile: FUSION_PROFILE wins over the
# harness panel.
PROFILE="${FUSION_PROFILE:-$ROOT/fusion.jsonc}"
UNIT="$HOME/.config/systemd/user/llama-server.service"

BASES="union-alpha glm glm-flash fable astra sol opus"
GRAFT_CMDS="build check map ask grep skeleton callers blast mcp"
SIDEKICKS="local local-fast local-deep glm deepseek strata strata-coder"
CRITICS="local strata flash lead"
SPEEDS="normal fast"
EFFORTS="low medium high xhigh max"
GUARDS="strict warn off"
ESCALATIONS="advise run fable"
ROUTING="observe enforce"

die() { echo "oc-fusion: $*" >&2; exit 1; }

in_list() { local n=$1; shift; for x in $*; do [ "$x" = "$n" ] && return 0; done; return 1; }

# Rewrite one top-level "key": value pair, preserving comments and layout.
set_key() {
  local key=$1 val=$2 quoted=$3
  python3 - "$PROFILE" "$key" "$val" "$quoted" <<'PY'
import re, sys
path, key, val, quoted = sys.argv[1:5]
s = open(path).read()
new = f'"{val}"' if quoted == "yes" else val
# Match a JSON scalar exactly, not "everything up to a comma". The loose
# version ate a trailing // comment on a value line (and silently failed on
# a line that had both a comma and a comment).
VAL = r'"(?:[^"\\]|\\.)*"|true|false|null|-?\d+(?:\.\d+)?'
pat = re.compile(
    rf'^(\s*"{re.escape(key)}"\s*:\s*)(?:{VAL})(\s*,?)(\s*(?://.*)?)$', re.M)
if not pat.search(s):
    sys.exit(f"oc-fusion: no \"{key}\" key in {path}")
s = pat.sub(lambda m: f"{m.group(1)}{new}{m.group(2)}{m.group(3)}", s, count=1)
open(path, "w").write(s)
PY
  echo "oc-fusion: $key = $val"
  echo "oc-fusion: quit opencode, then start \`oc\` again to apply. (\`oc\` restarts the"
  echo "           background server once no session runs on it; closing a window alone does not.)"
}

get_key() {
  python3 - "$PROFILE" "$1" <<'PY'
import re, sys
s = open(sys.argv[1]).read()
VAL = r'"(?:[^"\\]|\\.)*"|true|false|null|-?\d+(?:\.\d+)?'
m = re.search(rf'^\s*"{re.escape(sys.argv[2])}"\s*:\s*({VAL})', s, re.M)
print(m.group(1).strip('"') if m else "?")
PY
}

# Key files hold one key per line; # lines are comments. Use the first key,
# the same rule as the plugin's readKeyFile.
first_key() {
  [ -f "$1" ] || return 0
  sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" | grep -v -e '^#' -e '^$' | head -n 1
}

# Passive residency read. With a systemd unit, the child server's cmdline
# is the source; without one the server is remote and GET /v1/models on its
# configured baseURL answers instead. Both only read; neither can trigger a
# model load.
resident() {
  if [ -f "$UNIT" ]; then
    ps -eo args= 2>/dev/null | awk '/llama-server/ && /--alias/ {
      for (i=1;i<=NF;i++) if ($i=="--alias") { print $(i+1); exit }
    }'
    return
  fi
  local kf="${FUSION_API_KEY_FILE:-$HOME/.config/llama-server/api-key}"
  local base_url
  base_url=$(provider_json llamacpp base)
  [ -n "$base_url" ] || return 0
  [ -f "$kf" ] || return 0
  curl -sS -m 4 -H "Authorization: Bearer $(first_key "$kf")" "${base_url%/}/models" 2>/dev/null \
    | python3 -c 'import json,sys
try:
    ok = {"loaded", "loading", "ready", "sleeping"}
    print(" ".join(m["id"] for m in json.load(sys.stdin).get("data", [])
          if m.get("id") and ((m.get("status") or {}).get("value") or "loaded").lower() in ok))
except Exception: pass' 2>/dev/null
}

# The Strata model the panel uses ("" when sidekick and critic are not Strata):
# a strata-* sidekick, else strata-iq3 for critic "strata".
strata_alias() {
  local sk cr
  sk=$(get_key sidekick); cr=$(get_key critic)
  case "$sk" in
    strata) echo strata-iq3 ;;
    strata-*) echo "$sk" ;;
    *) [ "$cr" = "strata" ] && echo strata-iq3 || true ;;
  esac
}

# Passive: Strata's /health needs no key and never loads a model. Prints
# "<base> <declared id> <declared context> <served id> <max_context> <loaded>"
# for one alias of provider "strata" in opencode.jsonc.
strata_health() {
  python3 - "$ROOT/opencode.jsonc" "$1" <<'PY'
import json, re, sys, urllib.request
path, alias = sys.argv[1:3]
s = open(path).read()
s = re.sub(r'"(?:[^"\\]|\\.)*"|//[^\n]*', lambda m: m.group(0) if m.group(0).startswith('"') else "", s)
p = json.loads(re.sub(r",(\s*[}\]])", r"\1", s))["provider"]["strata"]
base = p["options"]["baseURL"].rstrip("/").removesuffix("/v1")
m = p["models"].get(alias, {})
try:
    h = json.load(urllib.request.urlopen(base + "/health", timeout=2))
except Exception:
    h = {}
print(base, m.get("id", "?"), m.get("limit", {}).get("context", "?"),
      h.get("model", "-"), h.get("max_context", "-"), str(h.get("loaded", "-")).lower())
PY
}

# Same JSONC parse strata_health uses, scoped to one provider's fields.
# Grepping the whole file for these now catches the Strata and gateway
# entries and warns on things this panel never asked llama-server for.
# Usage: provider_json <provider> base|contexts|ids
provider_json() {
  python3 - "$ROOT/opencode.jsonc" "$1" "$2" <<'PY'
import json, re, sys
s = open(sys.argv[1]).read()
s = re.sub(r'"(?:[^"\\]|\\.)*"|//[^\n]*', lambda m: m.group(0) if m.group(0).startswith('"') else "", s)
p = json.loads(re.sub(r",(\s*[}\]])", r"\1", s)).get("provider", {}).get(sys.argv[2], {})
what = sys.argv[3]
if what == "base":
    print(p.get("options", {}).get("baseURL", ""))
elif what == "contexts":
    ctxs = sorted(c for c in {m.get("limit", {}).get("context")
                              for m in p.get("models", {}).values()}
                  if isinstance(c, int))
    print(" ".join(map(str, ctxs)))
elif what == "ids":
    print(" ".join(sorted({m["id"] for m in p.get("models", {}).values() if m.get("id")})))
PY
}

usage() {
  cat <<EOF
usage: oc-fusion <command>

  status                 show the current panel and the live local server
  base       <$(echo $BASES | tr ' ' '|')>
  sidekick   <$(echo $SIDEKICKS | tr ' ' '|')>
                         strata / strata-coder pick the Strata model; when
                         "strata_remote_swap" names an ssh host in
                         fusion.jsonc the switch first runs `strata-use`
                         there (opt-in, off by default)
  critic     <$(echo $CRITICS | tr ' ' '|')>
  speed      <$(echo $SPEEDS | tr ' ' '|')>
  reasoning  <$(echo $EFFORTS | tr ' ' '|')>
  escalation <$(echo $ESCALATIONS | tr ' ' '|')>
  oracle     <$(echo $BASES | tr ' ' '|')>   (only used when escalation=fable)
  guard      <$(echo $GUARDS | tr ' ' '|')>
  compress   <on|off>
  usage                  aggregate .fusion/usage.jsonl (per-agent tokens + cost)
  doctor                 check the config against Strata and the llama-server
                         unit (or its remote endpoint when no unit exists)
  graft      <build|check|map|ask|grep|skeleton|callers|blast|mcp> [args...]
                         local graph in your current project; network-isolated
                         (macOS sandbox-exec, Linux unshare). See oc-fusion graft help.
  routing    <observe|enforce>
                         evidence routing: observe logs stalls/scope only,
                         enforce blocks repeated failures and out-of-scope edits
  work       <submit|list|results> [file|id]
                         seat <-> harness work orders (.fusion/inbox|outbox)
EOF
}

cmd=${1-status}
case "$cmd" in
  status)
    echo "lead      $(get_key base)   reasoning $(get_key reasoning)   speed $(get_key speed)"
    echo "sidekick  $(get_key sidekick)"
    echo "critic    $(get_key critic)"
    esc=$(get_key escalation)
    case "$esc" in
      advise) echo "escalate  advise   -> handoff brief for Claude Code (no spend)" ;;
      run)    echo "escalate  run      -> claude -p (subscription, no gateway spend)" ;;
      fable)  echo "escalate  fable    -> paid oracle subagent: $(get_key oracle) at max" ;;
      *)      echo "escalate  $esc   (unknown)" ;;
    esac
    echo "guard     $(get_key guard)   compress $(get_key compress_tool_output)   routing $(get_key routing)"
    echo
    sa=$(strata_alias)
    if [ -n "$sa" ]; then
      read -r s_base s_id _ s_model _ s_loaded <<<"$(strata_health "$sa")"
      if [ "$s_model" = "-" ]; then
        echo "strata    not answering at $s_base"
      else
        echo "strata    $s_model at $s_base (loaded: $s_loaded)"
        [ "$s_model" != "$s_id" ] && echo "  WARN: $sa expects \"$s_id\"; run that model in Strata or pick the other strata sidekick."
      fi
    fi
    local_res=$(resident || true)
    echo "resident  ${local_res:-<nothing loaded>} (llama-server)"
    if command -v systemctl >/dev/null; then
      echo "service   llama-server.service: $(systemctl --user is-active llama-server.service 2>/dev/null || echo unknown)"
    else
      # No systemd: the llamacpp endpoint is remote or behind a tunnel. A
      # listener on its local port is the best passive up/down signal.
      base_url=$(provider_json llamacpp base)
      port=$(printf '%s' "$base_url" | sed -n 's#.*:\([0-9][0-9]*\)/.*#\1#p')
      case "$base_url" in
        *://127.0.0.1:*|*://localhost:*|*://\[::1\]:*)
          if [ -n "$port" ] && lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
            echo "llama     endpoint $base_url: listener up"
          else
            echo "llama     endpoint $base_url: nothing listening (start the server or its tunnel)"
          fi ;;
        *) echo "llama     endpoint ${base_url:-<none>} (remote host; listener check skipped)" ;;
      esac
    fi
    ;;
  base|oracle)
    [ $# -ge 2 ] || die "usage: oc-fusion $cmd <$(echo $BASES | tr ' ' '|')>"
    in_list "$2" $BASES || die "unknown model \"$2\". Known: $BASES"
    set_key "$cmd" "$2" yes ;;
  sidekick)
    [ $# -ge 2 ] || die "usage: oc-fusion sidekick <$(echo $SIDEKICKS | tr ' ' '|')>"
    in_list "$2" $SIDEKICKS || die "unknown sidekick \"$2\". Known: $SIDEKICKS"
    # Strata serves one model, so switching between strata aliases means the
    # server must run the matching one. When the panel's strata_remote_swap
    # names an ssh destination (off by default), ask that host to swap first
    # and change the profile only if it worked.
    case "$2" in
      strata|strata-coder)
        sw=$(get_key strata_remote_swap)
        if [ -n "$sw" ] && [ "$sw" != "?" ] && [ "$sw" != "null" ]; then
          [ "$2" = strata ] && want=iq3 || want=coder
          ssh -o BatchMode=yes -o ConnectTimeout=5 "$sw" "strata-use $want" \
            || die "could not switch Strata to $want via $sw (busy or unreachable: run strata-use $want there and retry)"
        fi ;;
    esac
    set_key sidekick "$2" yes ;;
  critic)
    [ $# -ge 2 ] || die "usage: oc-fusion critic <$(echo $CRITICS | tr ' ' '|')>"
    in_list "$2" $CRITICS || die "unknown critic \"$2\". Known: $CRITICS"
    set_key critic "$2" yes ;;
  speed)
    [ $# -ge 2 ] || die "usage: oc-fusion speed <normal|fast>"
    in_list "$2" $SPEEDS || die "unknown speed \"$2\". Known: $SPEEDS"
    set_key speed "$2" yes ;;
  reasoning)
    [ $# -ge 2 ] || die "usage: oc-fusion reasoning <$(echo $EFFORTS | tr ' ' '|')>"
    in_list "$2" $EFFORTS || die "unknown level \"$2\". Known: $EFFORTS"
    set_key reasoning "$2" yes ;;
  escalation)
    [ $# -ge 2 ] || die "usage: oc-fusion escalation <$(echo $ESCALATIONS | tr ' ' '|')>"
    in_list "$2" $ESCALATIONS || die "unknown escalation \"$2\". Known: $ESCALATIONS"
    set_key escalation "$2" yes ;;
  guard)
    [ $# -ge 2 ] || die "usage: oc-fusion guard <strict|warn|off>"
    in_list "$2" $GUARDS || die "unknown guard \"$2\". Known: $GUARDS"
    set_key guard "$2" yes ;;
  routing)
    [ $# -ge 2 ] || die "usage: oc-fusion routing <observe|enforce>"
    in_list "$2" $ROUTING || die "unknown routing \"$2\". Known: $ROUTING"
    set_key routing "$2" yes ;;
  work)
    # Seat <-> harness work orders. Seats write a markdown brief with
    # frontmatter (id, seat) and "## Objective" / "## Acceptance" sections;
    # submit validates and files it in .fusion/inbox/. The lead claims it via
    # the work_order tool and reports to .fusion/outbox/.
    shift
    sub=${1:-list}
    case "$sub" in
      submit)
        [ $# -ge 2 ] || die "usage: oc-fusion work submit <file.md>"
        [ -f "$2" ] || die "no such file: $2"
        python3 - "$2" "$PWD/.fusion/inbox" <<'PY'
import re, shutil, sys, os
src, inbox = sys.argv[1], sys.argv[2]
text = open(src).read()
m = re.match(r"^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$", text)
errors = []
meta = {}
if not m:
    errors.append("missing frontmatter block (--- ... ---)")
else:
    for line in m.group(1).split("\n"):
        kv = re.match(r"^([A-Za-z_][\w-]*)\s*:\s*(.*)$", line)
        if kv:
            meta[kv.group(1)] = kv.group(2).strip().strip('"').strip("'")
    body = m.group(2)
    if not re.match(r"^[\w][\w.-]*$", meta.get("id", "")):
        errors.append('frontmatter needs "id: <slug>"')
    if not meta.get("seat"):
        errors.append('frontmatter needs "seat: <originating seat>"')
    if not re.search(r"^#{1,3}\s+.*objective", body, re.I | re.M):
        errors.append('body needs an "## Objective" section')
    if not re.search(r"^#{1,3}\s+.*acceptance", body, re.I | re.M):
        errors.append('body needs an "## Acceptance" section')
if errors:
    for e in errors: print(f"invalid: {e}", file=sys.stderr)
    sys.exit(1)
os.makedirs(inbox, exist_ok=True)
dest = os.path.join(inbox, meta["id"] + ".md")
shutil.copyfile(src, dest)
print(f"filed {meta['id']} (from {meta['seat']}) -> {dest}")
print("the lead picks it up with the work_order tool in an oc session")
PY
        ;;
      list)
        python3 - "$PWD/.fusion" <<'PY'
import json, os, re, sys
base = sys.argv[1]
inbox = os.path.join(base, "inbox")
state = {}
try:
    state = json.load(open(os.path.join(base, "work-orders.json"))).get("orders", {})
except Exception:
    pass
try:
    files = sorted(f for f in os.listdir(inbox) if f.endswith(".md"))
except FileNotFoundError:
    print("no inbox yet - seats submit with: oc-fusion work submit <file.md>")
    sys.exit(0)
if not files:
    print("inbox is empty")
for f in files:
    text = open(os.path.join(inbox, f)).read()
    m = re.match(r"^---\r?\n([\s\S]*?)\r?\n---", text)
    meta = dict(re.findall(r"^([A-Za-z_][\w-]*)\s*:\s*(.*)$", m.group(1), re.M)) if m else {}
    oid = meta.get("id", f[:-3]).strip().strip('"').strip("'")
    st = state.get(oid, {}).get("status", "pending")
    seat = meta.get("seat", "?").strip().strip('"').strip("'")
    print(f"{oid:<28} {st:<16} from {seat}")
PY
        ;;
      results)
        out="$PWD/.fusion/outbox"
        if [ ! -d "$out" ] || [ -z "$(ls -A "$out" 2>/dev/null)" ]; then
          echo "no results yet"; exit 0
        fi
        for f in "$out"/*.md; do
          echo "=== $(basename "$f") ==="
          head -12 "$f"
          echo
        done
        ;;
      *) die "usage: oc-fusion work <submit|list|results>" ;;
    esac
    ;;
  compress)
    [ $# -ge 2 ] || die "usage: oc-fusion compress <on|off>"
    case "$2" in on) v=true;; off) v=false;; *) die "use on or off";; esac
    set_key compress_tool_output "$v" no ;;
  graft)
    # Forward to the global graft CLI in the CALLER's project (cwd): never the
    # harness root. Explicit only: this path does not install graft, and it
    # builds or refreshes nothing on its own; a forwarded query may refresh the
    # project's local graft/ cache the way graft itself does.
    shift
    if [ $# -eq 0 ]; then
      cat <<'EOF'
usage: oc-fusion graft <build|check|map|ask|grep|skeleton|callers|blast|mcp> [args...]

Use the globally installed graft CLI (npm install -g @nanonets/graft) in
this project. The offline wrapper isolates the process AND its children from
the network (macOS sandbox-exec, Linux unshare); telemetry is disabled.
Missing isolation fails closed, never online.
This is network isolation, not a filesystem sandbox: queries may refresh the
local graph. Build explicitly once, then restart OpenCode to discover tools.
--deep is not supported here. Use plain graft outside Fusion if you explicitly
want provider-backed enrichment. oc-fusion graft --help shows the CLI manual.
EOF
      exit 0
    fi
    command -v graft >/dev/null || die "graft CLI not on PATH: npm install -g @nanonets/graft"
    case "$1" in
      -h|--help|help) set -- --help ;;
      *) in_list "$1" $GRAFT_CMDS || die "unknown graft command \"$1\". Known: $GRAFT_CMDS" ;;
    esac
    for arg in "$@"; do
      case "$arg" in --deep|--deep=*) die "--deep is outside Fusion's offline structural workflow" ;; esac
    done
    export DO_NOT_TRACK=1
    case "$(uname -s)" in
      Darwin)
        # Inline profile, no temp file. BSD mktemp does not randomize X's
        # followed by a suffix (".XXXXXX.sb" was a fixed name), and exec skips
        # the EXIT trap, so the file leaked and every later call failed with
        # "mkstemp failed: File exists".
        SB_PROFILE='(version 1)(allow default)(deny network*)'
        sandbox-exec -p "$SB_PROFILE" true 2>/dev/null || die "network isolation unavailable (sandbox-exec failed); refusing to run online"
        exec sandbox-exec -p "$SB_PROFILE" graft "$@"
        ;;
      Linux)
        command -v unshare >/dev/null || die "offline Graft requires Linux unshare (util-linux); refusing to run online"
        unshare --user --map-root-user --net true 2>/dev/null || die "network isolation unavailable; enable unprivileged user namespaces to use offline Graft"
        exec unshare --user --map-root-user --net -- graft "$@"
        ;;
      *) die "unsupported platform for the offline graft wrapper: $(uname -s)" ;;
    esac
    ;;
  doctor)
    sk=$(get_key sidekick)
    # Strata first when the panel uses it (a strata-* sidekick, or critic
    # "strata"): the declared alias checked passively against /health, which
    # needs no key and never loads a model.
    sa=$(strata_alias)
    if [ -n "$sa" ]; then
      read -r s_base s_id s_ctx s_model s_max s_loaded <<<"$(strata_health "$sa")"
      if [ "$s_model" = "-" ]; then
        echo "strata    WARN: Strata not answering at $s_base; start the Strata model for $sa."
      else
        echo "strata    $s_base serving \"$s_model\" max_context=$s_max loaded=$s_loaded"
        if [ "$s_model" != "$s_id" ]; then
          echo "  WARN: the panel names \"$s_id\" ($sa) but Strata serves \"$s_model\"."
          echo "        Requests still work: Strata ignores the model name, but the"
          echo "        panel and the server disagree. Pick the served model with"
          echo "        \`oc-fusion sidekick strata|strata-coder\`, or set that alias's"
          echo "        \"id\" in opencode.jsonc."
        fi
        if [ "$s_ctx" != "?" ] && [ "$s_max" != "-" ] && [ "$s_ctx" -gt "$s_max" ]; then
          echo "  WARN: declared $s_ctx > server $s_max; opencode may pack a prompt the server rejects."
        fi
      fi
      skey="${FUSION_STRATA_KEY_FILE:-$HOME/.config/strata/api-key}"
      if [ -s "$skey" ]; then
        echo "  ok: api key file $skey present."
      else
        echo "  WARN: api key file $skey missing or empty; Strata requests will be rejected."
      fi
    fi
    # llama.cpp: the checks only apply when a unit exists, and only to
    # provider.llamacpp in opencode.jsonc (scoped by provider_json, not by
    # grepping the file).
    if [ -f "$UNIT" ]; then
      ctx=$(grep -oP '(?<=-c )\d+' "$UNIT" | head -1)
      par=$(grep -oP '(?<=--parallel )\d+' "$UNIT" | head -1)
      mmax=$(grep -oP '(?<=--models-max )\d+' "$UNIT" | head -1)
      port=$(grep -oP '(?<=--port )\d+' "$UNIT" | head -1)
      echo "unit      ctx=$ctx parallel=$par models-max=$mmax port=$port"
      declared=$(provider_json llamacpp contexts)
      echo "declared  local context: $declared"
      for d in $declared; do
        if [ "$d" -ge "$ctx" ]; then
          echo "  WARN: declared $d >= server $ctx; opencode may pack a prompt the server rejects."
        fi
      done
      base_url=$(provider_json llamacpp base)
      echo "baseURL   $base_url"
      case "$base_url" in
        *":$port/"*) echo "  ok: baseURL port matches the unit." ;;
        *) echo "  WARN: baseURL does not use the unit's port ($port)." ;;
      esac
      r=$(resident || true)
      echo "resident  ${r:-<nothing loaded>}"
      if [ -n "$r" ]; then
        # The plugin stamps the resident wire id onto the local aliases at
        # load, so any pinned "id" here is a stale pin, not the source of truth.
        pinned=$(provider_json llamacpp ids)
        for p in $pinned; do
          [ "$p" != "$r" ] && [ "$p" != "local" ] && echo "  WARN: pinned \"$p\" differs from resident \"$r\"; the plugin will use the resident model."
        done
      else
        echo "  WARN: nothing resident; local agents will fail until a model is loaded."
      fi
      [ "$mmax" = "1" ] && echo "note      models-max=1: only one local model can be resident at a time."
      [ "$par" = "1" ] && echo "note      parallel=1: concurrent local calls queue rather than overlap."
    else
      # No systemd unit: when this panel uses llamacpp the server lives on
      # another host and is reached over HTTP (a tunnel, typically). All
      # reads are passive: /health, /v1/models and /props never name a
      # model, so they cannot trigger a load.
      base_url=$(provider_json llamacpp base)
      if [ -z "$base_url" ]; then
        echo "llama     no unit at $UNIT and provider.llamacpp has no baseURL (skipped)"
      else
        origin=$(printf '%s' "$base_url" | sed 's#/v1/*$##')
        port=$(printf '%s' "$base_url" | sed -n 's#.*:\([0-9][0-9]*\)/.*#\1#p')
        llama_used=
        if in_list "$sk" local local-fast local-deep || [ "$(get_key critic)" = "local" ]; then
          llama_used=1
        fi
        echo "endpoint  $base_url${llama_used:+ (remote llama-server)}${llama_used:- (not used by this panel)}"
        case "$base_url" in
          *://127.0.0.1:*|*://localhost:*|*://\[::1\]:*)
            if [ -n "$port" ] && lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
              echo "  ok: something is listening on localhost:$port."
            else
              echo "  WARN: nothing listening on localhost:$port; the server or its tunnel is down."
            fi ;;
        esac
        health=$(curl -sS -m 5 "$origin/health" 2>/dev/null | head -c 200 || true)
        case "$health" in
          *ok*|*'"status"'*) echo "  ok: server healthy." ;;
          *) echo "  WARN: /health unreachable: ${health:-<no answer>}" ;;
        esac
        key_file="${FUSION_API_KEY_FILE:-$HOME/.config/llama-server/api-key}"
        if [ -f "$key_file" ]; then
          echo "api-key   $key_file present."
        else
          echo "api-key   MISSING at $key_file; requests may be rejected."
        fi
        r=$(resident || true)
        echo "resident  ${r:-<none / unreachable>}"
        if [ -z "$r" ] && [ -n "$llama_used" ]; then
          echo "  WARN: nothing resident; local agents will fail until a model is loaded."
        fi
        props=$(curl -sS -m 5 -H "Authorization: Bearer $(first_key "$key_file")" "$origin/props" 2>/dev/null || true)
        ctx=$(printf '%s' "$props" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
    print(d.get("default_generation_settings",{}).get("n_ctx_slot") or d.get("n_ctx_slot") or "")
except Exception: pass' 2>/dev/null)
        if [ -n "$ctx" ]; then
          echo "ctx       $ctx tokens per slot (from /props)"
          declared=$(provider_json llamacpp contexts)
          for d in $declared; do
            [ "$d" -ge "$ctx" ] && echo "  WARN: declared $d >= per-slot $ctx; opencode may pack a prompt the server rejects."
          done
        else
          echo "ctx       unknown (server did not report it); pin \"local_ctx\" in fusion.jsonc."
        fi
      fi
    fi
    # Graft is part of the setup: the graph lives per-project, the CLI global.
    if command -v graft >/dev/null; then
      echo "graft     $(graft --version 2>/dev/null || echo installed)"
    else
      echo "graft     MISSING: npm install -g @nanonets/graft (agents fall back to grep until then)"
    fi
    if [ "$(uname -s)" = "Darwin" ] && command -v sandbox-exec >/dev/null; then
      echo "  ok: offline wrapper available (sandbox-exec network isolation for graft)."
    elif [ "$(uname -s)" = "Linux" ] && command -v unshare >/dev/null && unshare --user --map-root-user --net true 2>/dev/null; then
      echo "  ok: offline wrapper available (unshare network isolation for graft)."
    else
      echo "  WARN: network isolation unavailable; the graft wrapper refuses to run rather than go online."
    fi
    if [ -d "$PWD/graft" ]; then
      echo "  ok: graft/ index present in this project."
    else
      echo "  note: no graft/ index in this project: run \`graft build\` here once."
    fi
    # rtk compresses command output before any agent reads it.
    if command -v rtk >/dev/null; then
      echo "rtk       $(rtk --version 2>/dev/null || echo installed)"
    else
      echo "rtk       MISSING: brew install rtk (or cargo install --git https://github.com/rtk-ai/rtk)"
    fi
    # The opencode v2 background server: started from this harness, newer
    # than every config and plugin file, and fusion and rtk active here.
    if command -v python3 >/dev/null; then
      OPENCODE_CONFIG="${OPENCODE_CONFIG:-$ROOT/opencode.jsonc}" python3 "$ROOT/bin/oc-server" check "$PWD" || true
    fi
    ;;
  usage)
    # Aggregate .fusion/usage.jsonl (see block above for the implementation).
    f="$PWD/.fusion/usage.jsonl"
    if [ ! -f "$f" ]; then
      echo "no usage yet at $f"
      exit 0
    fi
    python3 - "$f" "$(get_key base)" <<'PY'
import json, sys
from collections import defaultdict

path, base = sys.argv[1], sys.argv[2]
# Lead rates ($/M in, $/M out) -- keep in step with the table in fusion.js.
LEAD = {"union-alpha": (0, 0), "glm": (0.70, 2.20), "glm-flash": (0.015, 0.05),
        "fable": (10, 50), "astra": (10, 50), "sol": (5, 30), "opus": (5, 25)}
rin, rout = LEAD.get(base, LEAD["glm"])

rows = []
with open(path) as fh:
    for line in fh:
        line = line.strip()
        if not line: continue
        try: rows.append(json.loads(line))
        except json.JSONDecodeError: pass

if not rows:
    print("usage log exists but has no readable lines"); sys.exit(0)

by_agent = defaultdict(lambda: [0,0,0,0.0,0])  # in, out, reasoning, cost, msgs
for r in rows:
    a = by_agent[r.get("agent", "unknown")]
    a[0] += r.get("in", 0); a[1] += r.get("out", 0)
    a[2] += r.get("reasoning", 0); a[3] += r.get("cost", 0.0); a[4] += 1

def fmt(n):
    return f"{n/1e6:.2f}M" if n >= 1e6 else f"{n/1e3:.1f}k"

total_cost = sum(v[3] for v in by_agent.values())
shadow_in  = sum(v[0] for k, v in by_agent.items() if k != "fusion")
shadow_out = sum(v[1] + v[2] for k, v in by_agent.items() if k != "fusion")
shadow = (shadow_in * rin + shadow_out * rout) / 1e6

print(f"{'agent':<10} {'msgs':>5} {'in':>8} {'out':>8} {'reasoning':>9} {'cost':>8}")
for k in sorted(by_agent, key=lambda k: -by_agent[k][3]):
    v = by_agent[k]
    print(f"{k:<10} {v[4]:>5} {fmt(v[0]):>8} {fmt(v[1]):>8} {fmt(v[2]):>9} ${v[3]:>7.3f}")
print(f"{'TOTAL':<10} {'':>5} {'':>8} {'':>8} {'':>9} ${total_cost:>7.3f}")
print()
print(f"lead model rates ({base}): ${rin}/${rout} per M in/out")
print(f"delegated tokens (non-lead): {fmt(shadow_in)} in / {fmt(shadow_out)} out+reasoning")
if rin == 0 and rout == 0:
    print("shadow cost at lead rates: $0.000 (free lead: delegation saves context and")
    print("rate-limit budget here, not money; switch base to a paid lead to price it)")
else:
    print(f"shadow cost if billed at lead rates: ${shadow:.3f}")
    print("(upper bound on what delegation saved; local agents actually cost $0)")
PY
    ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
